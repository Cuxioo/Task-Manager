{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Task Manager",
            "type": "shell",
            "command": "mvn",
            "args": [
                "compile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Task Manager (JavaFX)",
            "type": "shell",
            "command": "mvn",
            "args": [
                "javafx:run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
